# Mẫu cấu hình biến môi trường cho Backend Node.js Express
PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=your_jwt_secret_key_here

# ============================================================
# RESEND API Config (Khuyên dùng cho Render/Cloud Deployment)
# Đăng ký miễn phí tại: https://resend.com → API Keys → Create API Key
# ============================================================
RESEND_API_KEY=re_your_api_key_here
RESEND_TEST_EMAIL=your_testing_email@gmail.com
RESEND_FROM=FleetOS Logistics <onboarding@resend.dev>

# ============================================================
# [DỰ PHÒNG] SMTP Email Config (Gmail App Password)
# Chỉ hoạt động khi chạy Local hoặc VPS hỗ trợ cổng SMTP
# ============================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
