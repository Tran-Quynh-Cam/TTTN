# Mẫu cấu hình biến môi trường cho Backend Node.js Express
PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=your_jwt_secret_key_here

# SMTP Email Config (Gửi Lệnh Vận Chuyển)
# Lưu ý trên Render/Cloud Server: Dùng Cổng 465 (SSL) để tránh bị Firewall Render chặn cổng 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
